# ── AI Provider API Keys ─────────────────────────────────────
# v5는 API 키를 .env가 아니라 세션별로 저장한다 (SQLite session_provider_secrets).
# 로그인 후 UI 우측 상단 '프로바이더 설정'에서 입력하거나 /api/settings 로
# 저장한다. 여기에 ANTHROPIC_API_KEY 등을 적어도 서버는 읽지 않는다.

# ── Google 로그인 (선택 — 비우면 development 모드에서 mock 로그인으로 동작) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 서버 설정 (선택 — 기본값으로 충분) ────────────────────────
# PORT=8794
# CLIENT_ORIGIN=http://127.0.0.1:5194
# OAUTH_REDIRECT_BASE=http://127.0.0.1:8794

# ── 배포 모드 ─────────────────────────────────────────────────
# NODE_ENV=development  # mock 로그인 활성화(GOOGLE_CLIENT_ID/SECRET 미설정 시)
# NODE_ENV=production   # mock 로그인 완전 비활성 + 세션 쿠키 secure(HTTPS 전용)

# ── 관측성 (선택) ─────────────────────────────────────────────
# LOG_LEVEL=info   # pino 로그 레벨 (trace/debug/info/warn/error/silent)

# ── 동시성 튜닝 (선택) ────────────────────────────────────────
# MAX_WORKER_SPAWNS=2   # HWPX 빌드 워커 동시 실행 수 상한 (기본: CPU 코어 - 2)
